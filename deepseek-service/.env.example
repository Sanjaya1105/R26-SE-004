PORT=5004
# Must match main auth backend JWT_SECRET so browser tokens validate.
JWT_SECRET=super_secret_jwt_key_you_should_change

DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Optional — neural embeddings for faithfulness (falls back to lexical TF cosine)
HF_API_TOKEN=
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
