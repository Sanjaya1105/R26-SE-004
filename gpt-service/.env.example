PORT=5002
# Must match main auth backend JWT_SECRET so browser tokens validate.
JWT_SECRET=your_jwt_secret_same_as_backend

# Hugging Face Inference Providers (fine-grained token with "Make calls to Inference Providers")
HF_API_TOKEN=
HF_MODEL=openai/gpt-oss-120b:fastest
HF_MODEL_FALLBACKS=meta-llama/Llama-3.1-8B-Instruct:fastest,Qwen/Qwen2.5-7B-Instruct:fastest

# Optional: Hugging Face image generation (illustration + optional unlabeled base images)
# Use a token with "Inference" / "Make calls to the Inference API" (hf_...).
# HF_API_KEY=hf_...
# Router "hf-inference" may return 400 "Model not supported" for some models (e.g. sdxl-turbo).
# Verified working on Router: black-forest-labs/FLUX.1-schnell
# HF_IMAGE_API_URL=https://router.huggingface.co/hf-inference/models/black-forest-labs/FLUX.1-schnell
# HF_IMAGE_API_URL=https://router.huggingface.co/hf-inference/models/stabilityai/sdxl-turbo
# HF_IMAGE_API_URL=https://api-inference.huggingface.co/models/stabilityai/sdxl-turbo
# (HF_API_TOKEN works as an alias for the same bearer token if you already use it for chat.)
# SDXL-Turbo: code sends guidance_scale=0 and num_inference_steps=1 by default. Override with:
# HF_IMAGE_NUM_STEPS=1
# HF_IMAGE_GUIDANCE_SCALE=0
# HF_IMAGE_PARAMETERS_JSON={"parameters":{"width":1024,"height":1024}}
# HF_IMAGE_REQUEST_BODY=openai

# MongoDB Atlas — database name for this service
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/?appName=Cluster0
MONGO_DB_NAME=content_transfer
